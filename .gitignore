# Python
__pycache__/
*.py[cod]
.venv/
.venv_*/
*.egg-info/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data — the three raw CSV files are committed so the notebook runs from a
# fresh clone; everything derived from them is regenerated.
data/processed/*
!data/**/.gitkeep

# Outputs (regenerated by the notebook; figures are embedded in it)
outputs/figures/*
outputs/tables/*
!outputs/**/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/

# Secrets
.env
